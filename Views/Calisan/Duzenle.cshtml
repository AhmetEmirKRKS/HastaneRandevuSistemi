@using HastaneRandevuSistemi.Models.Hizmetler
@using HastaneRandevuSistemi.Models.Kullanicilar
@using HastaneRandevuSistemi.Models.Kurumlar
@model Calisan
@{
    ViewData["Title"] = "Çalışan Düzenle";
    var bolumler = (List<Bolum>)ViewBag.Bolumler;
    var hizmetler = (List<Hizmet>)ViewBag.Hizmetler;
    string uzmanlikVeyaGorev = Model is Doktor doktor ? doktor.UzmanlikAlani : ((SaglikPersoneli)Model).Gorev;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-1">Çalışan Düzenle</h2>
        <p class="text-muted">Tür: @(Model is Doktor ? "Doktor" : "Sağlık Personeli")</p>

        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger">@TempData["Hata"]</div>
        }

        <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Ad</label>
                <input name="ad" value="@Model.Ad" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Soyad</label>
                <input name="soyad" value="@Model.Soyad" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">E-posta</label>
                <input type="email" name="email" value="@Model.Email" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Uzmanlık Alanı / Görev</label>
                <input name="uzmanlikVeyaGorev" value="@uzmanlikVeyaGorev" class="form-control" required />
            </div>
            <div class="col-12">
                <label class="form-label">Bölüm</label>
                <select name="bolumId" class="form-select">
                    @foreach (var bolum in bolumler)
                    {
                        <option value="@bolum.Id" selected="@(bolum.Id == Model.BolumId)">@bolum.Sube.Ad - @bolum.Ad</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Verdiği Hizmetler</label>
                <div>
                    @foreach (var hizmet in hizmetler)
                    {
                        <div class="form-check form-check-inline">
                            <input type="checkbox" name="hizmetIdleri" value="@hizmet.Id" class="form-check-input" id="hizmet@(hizmet.Id)"
                                   checked="@Model.Hizmetler.Any(h => h.Id == hizmet.Id)" />
                            <label class="form-check-label" for="hizmet@(hizmet.Id)">@hizmet.Ad (@hizmet.Bolum.Ad)</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
