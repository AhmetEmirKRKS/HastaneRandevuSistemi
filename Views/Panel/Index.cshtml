@using HastaneRandevuSistemi.Models.Enums
@model List<HastaneRandevuSistemi.Models.Randevular.Randevu>
@{
    ViewData["Title"] = "Randevu Paneli";
}

<h2 class="mb-4">Randevularım</h2>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz randevunuz bulunmuyor.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tarih / Saat</th>
                <th>Hasta</th>
                <th>İşlem</th>
                <th>Süre</th>
                <th>Ücret</th>
                <th>Hasta Notu</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var randevu in Model)
            {
                <tr>
                    <td>@randevu.Baslangic.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@randevu.Hasta.GorunenAd</td>
                    <td>@randevu.Hizmet.Ad</td>
                    <td>@((randevu.Bitis - randevu.Baslangic).TotalMinutes) dk</td>
                    <td>@randevu.Ucret.ToString("N2") TL</td>
                    <td>@randevu.HastaNotu</td>
                    <td>
                        @randevu.DurumMetni
                        @if (randevu.RedNedeni != null)
                        {
                            <br />
                            <small class="text-muted">Neden: @randevu.RedNedeni</small>
                        }
                    </td>
                    <td>
                        @if (randevu.Durum == RandevuDurumu.Beklemede)
                        {
                            <form asp-action="Onayla" asp-route-id="@randevu.Id" method="post" class="mb-1">
                                <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                            </form>
                            <form asp-action="Reddet" asp-route-id="@randevu.Id" method="post" class="d-flex gap-1">
                                <input name="neden" class="form-control form-control-sm" placeholder="Red nedeni" required />
                                <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                            </form>
                        }
                        else if (randevu.Durum == RandevuDurumu.Onaylandi && randevu.Baslangic <= DateTime.Now)
                        {
                            <form asp-action="Tamamla" asp-route-id="@randevu.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-primary">Tamamlandı</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
