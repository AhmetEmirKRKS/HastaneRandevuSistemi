@{
    ViewData["Title"] = ViewBag.Baslik;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">@ViewBag.Baslik</h2>

        <form asp-action="@ViewBag.Action" asp-route-id="@ViewBag.Id" method="post">
            <div class="mb-3">
                <label class="form-label">Ad</label>
                <input name="ad" value="@ViewBag.Ad" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="@ViewBag.GeriAction" asp-route-id="@ViewBag.GeriId" class="btn btn-secondary">Vazgeç</a>
        </form>
    </div>
</div>
