@using HastaneRandevuSistemi.Models
@model HastaneRandevuSistemi.Models.Kurumlar.Sube
@{
    ViewData["Title"] = Model.Ad;
}

<a asp-action="Index">&larr; Kurumlara dön</a>
<div class="d-flex justify-content-between align-items-center mt-2 mb-4">
    <h2 class="mb-0">@Model.Kurum.Ad - @Model.Ad</h2>
    <div class="d-flex gap-1">
        <a asp-action="SubeDuzenle" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Şubeyi Düzenle</a>
        <form asp-action="SubeSil" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Şube silinsin mi?')">
            <button type="submit" class="btn btn-sm btn-outline-danger">Şubeyi Sil</button>
        </form>
    </div>
</div>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Bölümler</h4>
        <ul class="list-group mb-3">
            @foreach (var bolum in Model.Bolumler)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @bolum.Ad
                    <div class="d-flex gap-1">
                        <a asp-action="BolumDuzenle" asp-route-id="@bolum.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        <form asp-action="BolumSil" asp-route-id="@bolum.Id" method="post"
                              onsubmit="return confirm('Bölüm silinsin mi?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </div>
                </li>
            }
        </ul>

        <form asp-action="BolumEkle" method="post" class="d-flex gap-2">
            <input type="hidden" name="subeId" value="@Model.Id" />
            <input name="ad" class="form-control" placeholder="Yeni bölüm adı" required />
            <button type="submit" class="btn btn-outline-primary">Ekle</button>
        </form>
    </div>

    <div class="col-md-6">
        <h4>Çalışma Saatleri</h4>
        <table class="table">
            <thead>
                <tr><th>Gün</th><th>Açılış</th><th>Kapanış</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var saat in Model.CalismaSaatleri.OrderBy(c => Array.IndexOf(Gunler.Liste, c.Gun)))
                {
                    <tr>
                        <td>@Gunler.Ad(saat.Gun)</td>
                        <td>@saat.Acilis.ToString("HH:mm")</td>
                        <td>@saat.Kapanis.ToString("HH:mm")</td>
                        <td>
                            <form asp-action="CalismaSaatiSil" asp-route-id="@saat.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <form asp-action="CalismaSaatiEkle" method="post" class="d-flex gap-2">
            <input type="hidden" name="subeId" value="@Model.Id" />
            <select name="gun" class="form-select">
                @foreach (var gun in Gunler.Liste)
                {
                    <option value="@gun">@Gunler.Ad(gun)</option>
                }
            </select>
            <input type="time" name="acilis" class="form-control" required />
            <input type="time" name="kapanis" class="form-control" required />
            <button type="submit" class="btn btn-outline-primary">Ekle</button>
        </form>
    </div>
</div>
